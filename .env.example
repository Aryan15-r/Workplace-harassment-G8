# =============================================================================
# Workplace Harassment G8 — Environment Configuration
# =============================================================================

# Google Apps Script Web App URL for storing feedback submissions in Google Sheets.
# Follow docs/GOOGLE_SHEETS_FEEDBACK_SETUP.md to generate this URL.
# Example: https://script.google.com/macros/s/AKfycbxXXXXXXXXXXXXXXXXXXXXXXXXXXXXX/exec
VITE_FEEDBACK_ENDPOINT=

# Public production URL of the deployed presentation website.
# Used to generate printable and presentation QR codes pointing to /feedback.
# Example: https://workplace-harassment-universe.pages.dev
VITE_SITE_URL=https://workplace-harassment-universe.pages.dev
